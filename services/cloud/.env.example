# Copia a .env y rellena. Nunca subas el .env al repositorio.
PORT=8787
# https://<proyecto>.supabase.co
SUPABASE_URL=
# Conexión del rol daylios_service por el pooler de Supabase, región us-west-1.
DATABASE_URL=
# Settings, API, service_role. Solo en el servidor, nunca en la app de escritorio.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública de este servicio: los enlaces de invitación apuntan aquí.
PUBLIC_URL=
# Opcional. Sin ella las invitaciones se comparten copiando el enlace.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=DayliOS <hola@tudominio.com>
# Opcional. Página de descarga para quien abre una invitación sin la app.
DOWNLOAD_URL=
# Cloudflare R2 con la API de S3 (ADR-04). En local sirve MinIO.
S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=daylios
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Máximo por archivo en MB.
FILE_MAX_MB=200
# Para POST /internal/purge desde una tarea programada.
CRON_SECRET=
